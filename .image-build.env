# Local image build configuration.
#
# Precedence, from highest to lowest:
#   1. workflow_dispatch inputs
#   2. GitHub Repository Variables
#   3. values in this file
#   4. workflow defaults
#
# Keep credentials out of this file. Put registry credentials and HAP secrets
# in GitHub Actions Secrets instead.

# Image and release version.
IMAGE_TAG=1.0.0

# Architecture-specific base images. They may be completely different image
# references; do not assume that replacing amd64 with arm64 is valid.
BASE_IMAGE_AMD64=registry.cn-shanghai.aliyuncs.com/jing-images/linux_amd64_alpine:3.20.3
BASE_IMAGE_ARM64=registry.cn-shanghai.aliyuncs.com/jing-images/linux_arm64_alpine:3.20.3
BASE_REGISTRY_AMD64=registry.cn-shanghai.aliyuncs.com
BASE_REGISTRY_ARM64=registry.cn-shanghai.aliyuncs.com

# These names are local build image references. They are not pushed directly.
TARGET_IMAGE_AMD64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-promtail-vlogs-mongodb-amd64
TARGET_IMAGE_ARM64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-promtail-vlogs-mongodb-arm64

# Optional Aliyun destination. The final image is derived automatically from
# the last path component of TARGET_IMAGE_* and this registry/namespace.
ALIYUN_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ALIYUN_NAMESPACE=hap-mdy

# Optional explicit Aliyun overrides. Leave empty to use automatic derivation.
ALIYUN_IMAGE_AMD64=
ALIYUN_IMAGE_ARM64=

# Module switches. Missing/empty destination configuration skips only that
# module and writes the reason to the Actions job summary.
ENABLE_BUILD=true
ENABLE_ALIYUN_PUSH=true
ENABLE_RELEASE=true
ENABLE_HAP_WEBHOOK=true

# Docker build settings.
DOCKERFILE=Dockerfile
DOCKER_CONTEXT=.
