# Local image build configuration.
#
# Precedence, from highest to lowest:
#   1. workflow_dispatch inputs
#   2. GitHub Repository Variables
#   3. values in this file
#   4. workflow defaults
#
# Keep credentials out of this file. Put registry credentials and HAP secrets
# in GitHub Actions Secrets instead.

# Explicit Release tag. Image references below carry their own explicit Tags.
IMAGE_TAG=1.0.0
ARCHITECTURES=all
RELEASE_NAME=hap-promtail-vlogs-mongodb

# Architecture-specific base images. The official Alpine image automatically
# selects the native architecture. Replace these independently only when a
# project really needs different amd64/arm64 base image references.
BASE_IMAGE_AMD64=alpine:3.23
BASE_IMAGE_ARM64=alpine:3.23

# These are local build image references. Their contents are used as-is.
TARGET_IMAGE_AMD64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-promtail-vlogs-mongodb-amd64:1.0.0
TARGET_IMAGE_ARM64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-promtail-vlogs-mongodb-arm64:1.0.0

# Optional Aliyun registry settings.
ALIYUN_REGISTRY=registry.cn-hangzhou.aliyuncs.com

# Optional explicit Aliyun destinations. Their contents are used as-is.
ALIYUN_IMAGE_AMD64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-promtail-vlogs-mongodb-amd64:1.0.0
ALIYUN_IMAGE_ARM64=registry.cn-hangzhou.aliyuncs.com/hap-mdy/hap-promtail-vlogs-mongodb-arm64:1.0.0

# Module switches. Missing/empty destination configuration skips only that
# module and writes the reason to the Actions job summary.
ENABLE_ALIYUN_PUSH=true
ENABLE_RELEASE=true
ENABLE_HAP_WEBHOOK=true

# Docker build settings.
DOCKERFILE=Dockerfile
BUILD_CONTEXT=.
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
ALPINE_VERSION=3.23
